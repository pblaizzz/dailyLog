---
import { SITE } from '@/config';
import Search from './Search.astro';
import ThemeSwitch from '../ThemeSwitch.astro';
---

<header class="masthead">
  <nav class="frame" aria-label="主导航">
    <a class="wordmark" href="/" aria-label={`${SITE.title}首页`}><span aria-hidden="true">≋</span>{SITE.title}</a>
    <div class="actions">
      <a href="/#archive">目录</a>
      {SITE.blogPage && <a href={SITE.blogPage}>Blog</a>}
      <a href={`https://github.com/${SITE.githubId}`}>GitHub</a>
      <Search />
      <ThemeSwitch />
    </div>
  </nav>
</header>

<style>
  .masthead { border-bottom: 1px solid var(--theme-divider); }
  nav, .actions, .wordmark { display: flex; align-items: center; }
  nav { min-height: 68px; justify-content: space-between; gap: 12px; }
  .wordmark { gap: 9px; color: var(--theme-text); font: bold 25px/1 Georgia, serif; letter-spacing: -1px; }
  .wordmark span { display: grid; place-items: center; width: 30px; height: 30px; background: var(--theme-accent); color: var(--theme-bg); font: 30px/1 Georgia, serif; }
  .actions { gap: clamp(4px, 1.3vw, 20px); }
  .actions > a { display: grid; place-items: center; min-height: 44px; padding-inline: 4px; color: var(--theme-text); font-size: 14px; }
  .actions > a:hover { color: var(--theme-accent); }
  @media (max-width: 360px) {
    .wordmark span { display: none; }
    .wordmark { font-size: 22px; }
    .actions { gap: 2px; }
  }
</style>
