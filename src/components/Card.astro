---
import { parseTitle, toNumericUrl } from '@/util';

export interface Props {
  post: {
    url: string;
    frontmatter: {
      image: string;
      description: string;
      date: string;
      legacySlug?: string;
      issueTitle?: string;
      numericUrl?: string;
    };
  };
}

const { post } = Astro.props;
const legacySlug = post.frontmatter?.legacySlug;
const issueTitle = post.frontmatter?.issueTitle;
const link = post.frontmatter?.numericUrl ?? toNumericUrl(post.url);
const title = parseTitle(link, legacySlug, issueTitle);
const { image, description, date } = post.frontmatter;
---

<a
  href={link}
  data-astro-prefetch
  class="entry"
>
  <div class="thumbnail">{image && <img src={image} alt="" loading="lazy" width="200" height="130" />}</div>
  <div class="copy">
    <time class="folio" datetime={date.replaceAll('/', '-')}>{date}</time>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <span class="arrow" aria-hidden="true">↗</span>
</a>

<style>
  .entry { display: grid; grid-template-columns: clamp(96px, 17vw, 188px) minmax(0, 1fr) auto; gap: clamp(14px, 3vw, 38px); padding-block: 22px; border-bottom: 1px solid var(--theme-divider); color: var(--theme-text); }
  .thumbnail { aspect-ratio: 1.65; background: repeating-linear-gradient(135deg, transparent 0 6px, var(--theme-divider) 7px 8px); }
  .thumbnail img { width: 100%; height: 100%; object-fit: cover; }
  .copy h3 { margin: 4px 0; font: 700 clamp(21px, 2.3vw, 29px)/1.3 var(--display); }
  .copy p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 15px; color: var(--muted); }
  .arrow { font: 24px/1 var(--display); color: var(--theme-accent); }
  .entry:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 480px) { .entry { grid-template-columns: 84px minmax(0, 1fr); } .arrow { display: none; } .thumbnail { aspect-ratio: 1; } }
</style>
