---
import "../styles/markdown.css";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header/Header.astro";
import LeftSidebar from "../components/LeftSidebar.astro";
import { SITE } from "@/config";
import { parseTitle, sortPosts, toNumericUrl } from "@/util";

export interface Props {
  frontmatter: {
    date: string;
    image: string;
    description: string;
    url: string;
    socialImage: string;
    numericUrl?: string;
    legacySlug?: string;
    issueTitle?: string;
    issueNumber?: number;
  };
}

const pageUrl = new URL(Astro.request.url);
const currentPage = pageUrl.pathname;
const normalize = (path: string | undefined) => {
  if (!path) return path;
  return path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;
};
const {
  date,
  image,
  description,
  url,
  socialImage,
  numericUrl,
  legacySlug,
  issueTitle
} = Astro.props.frontmatter;

const normalizedCurrent = normalize(currentPage) ?? currentPage;
const normalizedNumeric = normalize(numericUrl);
const effectivePath = normalizedNumeric ?? normalizedCurrent;
let title = parseTitle(effectivePath, legacySlug, issueTitle);

const content = {
  title,
  image: image,
  description,
  socialImage,
};
const currentUrl = `${SITE.homePage}${effectivePath}`;

// The next article
const posts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true }));
const allPosts = sortPosts(posts);
const navUrls = allPosts.map((post: any) => post.frontmatter?.numericUrl ?? toNumericUrl(post.url));
const position = navUrls.indexOf(effectivePath);
const nextUrl = position > 0 ? navUrls[position - 1] : undefined;
const prevUrl = position >= 0 ? navUrls[position + 1] : undefined;
---

<BaseLayout
  title={`${title} · ${SITE.title}`}
  content={content}
  pageURL={currentUrl}
>
  <Header />
  <main class="frame reading">
    <aside><LeftSidebar currentPage={effectivePath} /></aside>
    <div class="column">
      <article data-pagefind-body={normalizedCurrent === effectivePath ? true : undefined}>
        <header class="article-head">
          <p class="folio">{SITE.title} / 个人手记</p>
          <h1 data-pagefind-meta="title">{title}</h1>
          <p class="byline">{SITE.author} · <a href={`https://github.com/${SITE.repo}/blob/HEAD/src/pages${url ?? `/posts/${legacySlug}`}.md`} title="在 GitHub 查看原文"><time data-pagefind-sort="date" datetime={date.replaceAll('/', '-')}>{date}</time></a></p>
        </header>
        <div id="write" class="markdown-body heti"><slot /></div>
      </article>
      <nav class="post-nav" aria-label="期刊导航">
        <a href="/#archive">← 手记目录</a>
        {prevUrl && <a href={prevUrl}>上一期</a>}
        {nextUrl && <a href={nextUrl}>下一期</a>}
        <a href={`https://github.com/${SITE.repo}`}>GitHub ↗</a>
      </nav>
      <script
        is:inline
        id="giscus-script"
        src="https://giscus.app/client.js"
        data-repo={SITE.repo}
        data-repo-id="R_kgDOQLNmxA"
        data-category="General"
        data-category-id="DIC_kwDOQLNmxM4CxM_Q"
        data-mapping="title"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="https://gw.alipayobjects.com/os/k/kr/comment.css"
        data-lang="zh-CN"
        crossorigin="anonymous"
        async></script>
    </div>
  </main>

</BaseLayout>

<style>
  .reading { display: grid; grid-template-columns: minmax(140px, 200px) minmax(0, 740px); gap: clamp(28px, 6vw, 88px); padding-block: clamp(28px, 5vw, 60px); color: var(--theme-text); }
  aside { align-self: start; position: sticky; top: 20px; }
  .article-head { padding-bottom: 24px; margin-bottom: 24px; border-bottom: 1px solid var(--theme-divider); }
  .article-head h1 { font: 700 clamp(32px, 5vw, 58px)/1.2 var(--display); margin: 12px 0; overflow-wrap: anywhere; }
  .byline, .byline a { font-size: 14px; color: var(--muted); }
  .byline a:hover, .post-nav a:hover { text-decoration: underline; }
  #write { --text-font: var(--font-body); color: var(--theme-text); }
  #write :global(pre), #write :global(iframe) { max-width: 100%; margin-inline: 0; }
  .post-nav { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; padding-block: 12px; margin-block: 28px; border-block: 1px solid var(--theme-divider); }
  .post-nav a { display: inline-flex; min-height: 44px; color: var(--theme-accent); }
  @media (max-width: 760px) { .reading { grid-template-columns: minmax(0, 1fr); } aside { display: none; } }
</style>
