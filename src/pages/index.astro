---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Header from '../components/Header/Header.astro';
import { SITE } from '@/config';
import { sortPosts } from '@/util';

const posts = sortPosts(Object.values(import.meta.glob('./posts/*.md', { eager: true })));
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <Header />
  <main id="archive" class="frame journal">
    <h1 class="sr-only">{SITE.title} · 手记目录</h1>
    {posts.length ? <ol>{posts.map((post) => <li><Card post={post} /></li>)}</ol> : <p>第一期正在准备中。</p>}
  </main>
</BaseLayout>

<style>
  .journal { padding-block: 24px 64px; }
  ol { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 320px)); gap: 24px; list-style: none; padding: 0; }
  @media (max-width: 600px) { ol { grid-template-columns: minmax(0, 1fr); } }
</style>
